# AWS credentials for local development
# In Amplify, use the service role — no env vars needed for credentials.
APP_REGION=us-east-1
APP_ACCESS_KEY_ID=your_access_key_here
APP_SECRET_ACCESS_KEY=your_secret_key_here

# Bedrock model (default: Amazon Nova Pro)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
